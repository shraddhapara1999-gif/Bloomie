# ── Frontend (public, bundled into the browser) ─────────────────────────────
# Only put PUBLIC values here. Never put a service-role key or provider secret
# in a VITE_ variable — it would be visible to every visitor.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: show "Continue with Google" (configure the Google provider in Supabase first)
VITE_ENABLE_GOOGLE_AUTH=false

# Optional: web push. Public VAPID key (generate with `npx web-push generate-vapid-keys`)
VITE_VAPID_PUBLIC_KEY=

# Optional: release label recorded with client error logs
VITE_APP_RELEASE=

# ── Edge Function secrets (server-side only) ────────────────────────────────
# Set these with `supabase secrets set NAME=value` — NOT in this file for production.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.
#
# APP_URL=https://your-app.vercel.app
# ALLOWED_ORIGINS=https://your-app.vercel.app
# CRON_SECRET=long-random-string
# RESEND_API_KEY=re_...                # email reminders (optional)
# EMAIL_FROM="Bloomie <reminders@yourdomain.com>"
# VAPID_PUBLIC_KEY=...                 # web push (optional)
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:support@yourdomain.com
# ANTHROPIC_API_KEY=sk-ant-...         # optional AI journal prompts (users must opt in)
